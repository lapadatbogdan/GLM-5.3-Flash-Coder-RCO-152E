diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 7e69744..2216c4c 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1826,8 +1826,19 @@ int llama_context::decode(const llama_batch_ext & batch_inp) {
 
     llama_memory_context_ptr mctx;
 
+    // decode micro-batching (LLAMA_DECODE_MICROBATCH=k): a batch of at most k tokens per sequence of pure decode steps
+    // is cut into k micro-batches so the layer-split pipeline overlaps them across devices; prompt batches keep n_ubatch
+    uint32_t n_ubatch_eff = cparams.n_ubatch;
+    {
+        static const int mb_k = [] { const char * e = getenv("LLAMA_DECODE_MICROBATCH"); return e ? atoi(e) : 0; }();
+        const uint32_t n_seqs_in = balloc->get_n_used_seqs();
+        if (mb_k > 1 && n_seqs_in > 1 && n_tokens_all <= 4*n_seqs_in) {
+            n_ubatch_eff = std::max<uint32_t>(1, (n_tokens_all + mb_k - 1) / mb_k);
+        }
+    }
+
     while (true) {
-        mctx = memory->init_batch(*balloc, cparams.n_ubatch, output_all);
+        mctx = memory->init_batch(*balloc, n_ubatch_eff, output_all);
         if (!mctx) {
             return -2;
         }
